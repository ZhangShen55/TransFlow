FROM python:3.12.11-slim-bookworm AS builder

ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ARG CYTHON_VERSION=3.1.3
ARG APT_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/debian
ARG APT_SECURITY_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/debian-security

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DEFAULT_TIMEOUT=300 \
    PIP_INDEX_URL=${PIP_INDEX_URL}

WORKDIR /app

# Cython 只在构建阶段使用，运行镜像不包含编译工具链。
RUN sed -i \
    -e "s|http://deb.debian.org/debian-security|${APT_SECURITY_MIRROR}|g" \
    -e "s|http://deb.debian.org/debian|${APT_MIRROR}|g" \
    /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install --no-install-recommends -y gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src
COPY config.toml ./config.toml

# 先安装项目依赖，再把业务模块编译为 CPython 扩展。
RUN python -m pip install --prefix=/install . \
    && python -m pip install "Cython==${CYTHON_VERSION}" "setuptools==80.9.0" \
    && python - <<'PY'
from pathlib import Path

from Cython.Build import cythonize
from setuptools import Extension, setup

root = Path("src/transflow")
source_root = Path("src")
sources = sorted(path for path in root.rglob("*.py") if path.name != "__init__.py")
extensions = [
    Extension(
        ".".join(path.relative_to(source_root).with_suffix("").parts),
        [str(path)],
    )
    for path in sources
]

setup(
    name="transflow-cython-build",
    ext_modules=cythonize(
        extensions,
        compiler_directives={"language_level": 3},
        quiet=True,
    ),
    script_args=["build_ext", "--inplace"],
)
PY

# 运行镜像只保留扩展模块和包初始化文件，避免复制业务源码。
RUN find src/transflow -type f -name "*.c" -delete \
    && find src/transflow -type f -name "*.py" ! -name "__init__.py" -delete \
    && find src/transflow -type d -name "__pycache__" -prune -exec rm -rf {} + \
    && find src/transflow -type d -name "build" -prune -exec rm -rf {} + \
    && rm -rf /install/lib/python3.12/site-packages/transflow \
    && rm -rf /install/lib/python3.12/site-packages/transflow-*.dist-info

FROM python:3.12.11-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

RUN groupadd --system transflow \
    && useradd --system --gid transflow --create-home transflow

WORKDIR /app

COPY --from=builder /install /usr/local
COPY --from=builder /app/src /app/src
COPY --from=builder /app/config.toml /app/config.toml

USER transflow

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/live', timeout=2)"]

CMD ["uvicorn", "transflow.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
